# =============================================================================
# BalanceVault Environment Configuration
# =============================================================================

# Server Port
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# PostgreSQL Connection Strings
# For local dev / Docker / SQLite fallback:
# If testing without external Postgres, SQLite format file:./dev.db can be used in schema.prisma.
# For Neon / Hosted Postgres:
DATABASE_URL="postgresql://balancevault_app:AppUserSecurePass123!@ep-xyz.us-east-2.aws.neon.tech/balancevault?sslmode=require"

# Dedicated Database Role for Admin Bootstrapping (matches Neon SET ROLE pattern)
# This user belongs to 'bootstrap_operator' role with EXECUTE on admin_bootstrap() function
BOOTSTRAP_DATABASE_URL="postgresql://balancevault_bootstrap:BootstrapPass123!@ep-xyz.us-east-2.aws.neon.tech/balancevault?sslmode=require"

# Redis Configuration (Used for sliding window rate limiting)
# If Redis is unavailable locally, the application gracefully degrades to in-memory rate limiting.
REDIS_URL="redis://localhost:6379"
ENABLE_REDIS=true

# JWT Authentication Secrets
JWT_SECRET="super-secure-balancevault-jwt-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_SECRET="refresh-token-secret-change-in-production-2026"

# First Administrator Bootstrap Secret (Must be supplied during bootstrap ceremony)
BOOTSTRAP_SECRET_KEY="bv-bootstrap-super-secret-key-98765"

# Initial Super Admin Defaults for Bootstrap
INITIAL_ADMIN_EMAIL="admin@balancevault.internal"
INITIAL_ADMIN_NAME="System Super Administrator"
INITIAL_ADMIN_PASSWORD="AdminSecureVaultPass2026!"

# CORS Configuration
CLIENT_ORIGIN="http://localhost:5173"

